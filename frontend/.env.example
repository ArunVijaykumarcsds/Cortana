# CORTANA frontend — environment variables
#
# None of these are required yet: the app currently runs entirely on the
# mock-data layer in src/data/mock/. They are placeholders for the
# integration phase described in the frontend brief (FastAPI + PostgreSQL).
#
# Vite only exposes variables prefixed with VITE_ to client code.

# Base URL of the FastAPI backend once it exists, e.g. https://api.cortana.internal
VITE_API_BASE_URL=

# Feature flag: set to "true" to switch the data layer from mock to live API
# (not read anywhere yet — added here so the wiring is a config change, not
# a code change, when the backend is ready)
VITE_USE_LIVE_API=false
